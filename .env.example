# Copy this file to .env.local and fill in your keys.
# OpenWeatherMap API key (free tier is sufficient) — https://home.openweathermap.org/api_keys
VITE_OPENWEATHER_API_KEY=

# Optional: Mapbox public token for premium map tiles.
# Falls back to OpenStreetMap tiles when empty. — https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=